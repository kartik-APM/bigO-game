{
  "name": "bigo-drill",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:snippets": "node scripts/check-snippets.mjs",
    "check": "npm run typecheck && npm test && npm run check:snippets && npm run db:answers:check && npm run build",
    "db:answers": "node scripts/gen-answers-sql.mjs",
    "db:answers:check": "node scripts/gen-answers-sql.mjs --check"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@supabase/supabase-js": "^2.109.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "5.7",
    "vite": "^6.4.5",
    "vitest": "^3.2.7"
  }
}
